/.gitattributes text eol=lf

*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
Makefile text eol=lf

# .githooks/* 是无扩展名的 bash 脚本：CRLF 检出会让 `#!/usr/bin/env bash` 失效
# （Windows 上 core.autocrlf=true 时尤其明显：钩子直接不跑或报 bad interpreter）。
.githooks/* text eol=lf
.githooks/** text eol=lf

# 内嵌资产是 go:embed 的输入：字节必须稳定 —— CRLF 检出会让按内容断言的测试
# 在 Windows 上变红（见 boot_seed_test.go 的 "API_KEY=\n" 模板断言）。
internal/bootseed/assets/** text eol=lf
