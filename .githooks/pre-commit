#!/usr/bin/env bash
# 快速护栏（<2s，只读暂存区）：拦下三类反复出现的事故——BOM、CRLF、暂存不该入库的东西。
# 跳过：SEELEX_SKIP_HOOKS=1（会打印原因）。空白错误只提示不拦。
# 规范说明见同目录 README.md。
set -uo pipefail

# resolve_tool：先看 PATH，再退到 GOROOT（GUI git 客户端/精简 shell 常常没有 Go 的 PATH）。
# SEELEX_GOFMT / SEELEX_GO 只给钩子自测替换（scripts/hooks-selftest.sh）。
resolve_tool() {
  local override="$1" name="$2"
  if [[ -n "$override" ]]; then printf '%s' "$override"; return; fi
  if command -v "$name" >/dev/null 2>&1; then command -v "$name"; return; fi
  if command -v go >/dev/null 2>&1; then
    local root
    root="$(go env GOROOT 2>/dev/null || true)"
    if [[ -n "$root" && -x "$root/bin/$name" ]]; then printf '%s' "$root/bin/$name"; return; fi
  fi
  printf '%s' ""
}

if [[ "${SEELEX_SKIP_HOOKS:-0}" == "1" ]]; then
  echo "[pre-commit] 已按 SEELEX_SKIP_HOOKS=1 跳过检查"
  exit 0
fi

staged=$(git diff --cached --name-only --diff-filter=ACMR || true)
[[ -z "$staged" ]] && exit 0

fail=0

# 1) .go 不得带 UTF-8 BOM（PowerShell Set-Content 会加）或 CRLF（脚本写文件漏了 newline="\n"）
go_files=$(printf '%s\n' "$staged" | grep -E '\.go$' || true)
if [[ -n "$go_files" ]]; then
  while IFS= read -r f; do
    [[ -f "$f" ]] || continue
    if [[ "$(head -c 3 "$f" | od -An -tx1 | tr -d ' \n')" == "efbbbf" ]]; then
      echo "[pre-commit] $f 带 UTF-8 BOM：Go 源码必须无 BOM（用 apply_patch 或落盘脚本 WriteAllText(UTF8Encoding(\$false))）" >&2
      fail=1
    fi
    if grep -qU $'\r' "$f" 2>/dev/null; then
      echo "[pre-commit] $f 含 CRLF：.gitattributes 规定 *.go 用 LF（Python write_text 要显式 newline=\"\\n\"）" >&2
      fail=1
    fi
  done <<< "$go_files"

  # 2) 暂存区里的 .go 必须 gofmt 干净
  gofmt_bin="$(resolve_tool "${SEELEX_GOFMT:-}" gofmt)"
  if [[ -z "$gofmt_bin" ]]; then
    # 找不到工具链时**必须说出来**：静默通过等于这条护栏不存在（2026-10-16 自测发现
    # 精简 PATH 下它一直在空转）。
    echo "[pre-commit] ⚠ PATH 与 GOROOT 都找不到 gofmt：**本次未执行格式检查**（把 Go 加进 PATH，或 SEELEX_SKIP_HOOKS=1 显式跳过）" >&2
  else
    unformatted=$(printf '%s\n' "$go_files" | while IFS= read -r f; do
      [[ -f "$f" ]] || continue
      "$gofmt_bin" -l "$f" 2>/dev/null
    done)
    if [[ -n "$unformatted" ]]; then
      echo "[pre-commit] 下面这些暂存的 .go 没 gofmt 干净（跑 gofmt -w 后重新 git add）：" >&2
      printf '  %s\n' $unformatted >&2
      fail=1
    fi
  fi
fi

# 3) 不许暂存"临时工作区"与真实配置
forbidden=$(printf '%s\n' "$staged" | grep -E '^(tmp/|_tmp/|_scratch/|_logs/|dist/)' || true)
if [[ -n "$forbidden" ]]; then
  echo "[pre-commit] 下面这些路径不该进版本库（gitignore 覆盖的临时工作区）：" >&2
  printf '  %s\n' $forbidden >&2
  fail=1
fi
secrets=$(printf '%s\n' "$staged" | grep -E '^config/(accounts\.yaml|account-pool\.yaml|mcp\.yaml|search_engine\.yaml)$|^config/.*\.(local|secret)\.yaml$' || true)
if [[ -n "$secrets" ]]; then
  echo "[pre-commit] 真实配置不得入库（只允许 config/*.example.yaml 与 config/seele.yaml、config/seelex.yaml）：" >&2
  printf '  %s\n' $secrets >&2
  fail=1
fi

# 4) 空白错误只提示不拦（文档里常有历史性的尾随空格）
if ! git diff --cached --check >/dev/null 2>&1; then
  echo "[pre-commit] 提示：git diff --cached --check 有空白类告警（不拦提交）" >&2
fi

exit "$fail"
