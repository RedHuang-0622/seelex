.env
.env.*
*.env

# ── 依赖缓存 ────────────────────────────────────────────────
# 只忽略仓库根的 Go vendor 缓存目录；gui/frontend/dist/vendor/ 是前端
# 第三方组件生产资产（随 embed 打进二进制），必须纳入版本库。
/vendor/
node_modules/

# 仓库内 Go 构建缓存（GOCACHE 指向仓库时生成，含 trim.txt 与 xx/ 分片）
.gocache/
# 前端 / Node 工具链缓存；gui/frontend/dist/ 下的源码与 vendor 仍入库
gui/frontend/.cache/
gui/frontend/.vite/
.vite/
*.tsbuildinfo
.eslintcache

# 本地 Python 虚拟环境
.venv/

