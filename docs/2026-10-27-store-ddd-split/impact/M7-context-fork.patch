diff --git a/store/context/fork.go b/store/context/fork.go
new file mode 100644
index 00000000..51b947b4
--- /dev/null
+++ b/store/context/fork.go
@@ -0,0 +1,81 @@
+package context
+
+import (
+	"encoding/json"
+	"fmt"
+	"time"
+)
+
+// ForkOptions 描述子会话从父 context 分叉时的裁剪输入。
+type ForkOptions struct {
+	ForkedFrom   json.RawMessage
+	CutEventSeq  uint64
+	CutTime      time.Time
+	CutMessageID string
+}
+
+// ForkState 把父 context payload 重写为独立子会话 payload，并返回重写后的
+// compact frames。函数无 I/O：父 payload 读取和子 payload 写入由调用方负责。
+func ForkState(payload []byte, opts ForkOptions) ([]byte, []CompactFrame, error) {
+	record := SessionContextRecord{SchemaVersion: SessionContextSchemaVersion}
+	if len(payload) > 0 {
+		if err := json.Unmarshal(payload, &record); err != nil {
+			return nil, nil, fmt.Errorf("decode parent context: %w", err)
+		}
+		if record.SchemaVersion != SessionContextSchemaVersion {
+			return nil, nil, fmt.Errorf(
+				"parent context has unsupported schema version %d (want %d)",
+				record.SchemaVersion, SessionContextSchemaVersion,
+			)
+		}
+	}
+	record.PlanStack = nil
+	record.TaskStack = nil
+	record.GoalStack = nil
+	record.GoalAudit = nil
+	record.ForkedFrom = append(json.RawMessage(nil), opts.ForkedFrom...)
+	record.SkillStack = forkSkillFrames(record.SkillStack, opts.CutTime)
+	frames := RewriteForkCompactStack(record.CompactStack, opts.CutEventSeq, opts.CutMessageID)
+	record.CompactStack = frames
+	data, err := json.Marshal(record)
+	if err != nil {
+		return nil, nil, fmt.Errorf("encode child context: %w", err)
+	}
+	return data, frames, nil
+}
+
+func forkSkillFrames(frames []SkillFrame, cutTime time.Time) []SkillFrame {
+	result := make([]SkillFrame, 0, len(frames))
+	for _, frame := range frames {
+		if frame.ActivatedAt.IsZero() || !frame.ActivatedAt.After(cutTime) {
+			result = append(result, frame)
+		}
+	}
+	return result
+}
+
+// RewriteForkCompactStack 在分叉点裁剪继承的 compact frames：无事件坐标的旧帧
+// 保守保留；完全在切点前的帧原样保留；完全在切点后的帧丢弃；跨切点帧把事件
+// 与消息终点截到切点身份。
+func RewriteForkCompactStack(frames []CompactFrame, cut uint64, cutMessageID string) []CompactFrame {
+	result := make([]CompactFrame, 0, len(frames))
+	for _, frame := range frames {
+		if frame.EventFrom == 0 && frame.EventTo == 0 {
+			result = append(result, frame)
+			continue
+		}
+		if frame.EventTo <= cut {
+			result = append(result, frame)
+			continue
+		}
+		if frame.EventFrom > cut {
+			continue
+		}
+		frame.EventTo = cut
+		if cutMessageID != "" {
+			frame.MessageTo = cutMessageID
+		}
+		result = append(result, frame)
+	}
+	return result
+}
diff --git a/store/context/fork_test.go b/store/context/fork_test.go
new file mode 100644
index 00000000..5e557b5b
--- /dev/null
+++ b/store/context/fork_test.go
@@ -0,0 +1,88 @@
+package context
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestForkStateCreatesEmptyChild(t *testing.T) {
+	forkedFrom := json.RawMessage(`{"parent":"p1","cut":7}`)
+	payload, frames, err := ForkState(nil, ForkOptions{ForkedFrom: forkedFrom})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(frames) != 0 {
+		t.Fatalf("empty child frames=%+v", frames)
+	}
+	var record SessionContextRecord
+	if err := json.Unmarshal(payload, &record); err != nil {
+		t.Fatal(err)
+	}
+	if record.SchemaVersion != SessionContextSchemaVersion || string(record.ForkedFrom) != string(forkedFrom) {
+		t.Fatalf("child record=%+v", record)
+	}
+}
+
+func TestForkStateFiltersSkillsAndRewritesCompactFrames(t *testing.T) {
+	cutTime := time.Unix(100, 0)
+	parent := SessionContextRecord{
+		SchemaVersion: SessionContextSchemaVersion,
+		PlanStack:     []PlanFrame{{PlanID: "plan"}},
+		TaskStack:     []TaskFrame{{TaskID: "task"}},
+		GoalStack:     []GoalFrame{{GoalID: "goal"}},
+		GoalAudit:     []GoalAuditEntry{{GoalID: "goal", Kind: "goal.begin"}},
+		SkillStack: []SkillFrame{
+			{SkillID: "before", ActivatedAt: cutTime},
+			{SkillID: "after", ActivatedAt: cutTime.Add(time.Second)},
+		},
+		CompactStack: []CompactFrame{
+			{SegmentID: "legacy"},
+			{SegmentID: "before", EventFrom: 1, EventTo: 4},
+			{SegmentID: "cross", EventFrom: 3, EventTo: 9, MessageTo: "old"},
+			{SegmentID: "after", EventFrom: 8, EventTo: 12},
+		},
+	}
+	parentPayload, err := json.Marshal(parent)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	childPayload, frames, err := ForkState(parentPayload, ForkOptions{
+		ForkedFrom:   json.RawMessage(`{"parent":"p1"}`),
+		CutEventSeq:  7,
+		CutTime:      cutTime,
+		CutMessageID: "cut-message",
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(frames) != 3 || frames[2].SegmentID != "cross" ||
+		frames[2].EventTo != 7 || frames[2].MessageTo != "cut-message" {
+		t.Fatalf("frames=%+v", frames)
+	}
+	var child SessionContextRecord
+	if err := json.Unmarshal(childPayload, &child); err != nil {
+		t.Fatal(err)
+	}
+	if len(child.PlanStack) != 0 || len(child.TaskStack) != 0 ||
+		len(child.GoalStack) != 0 || len(child.GoalAudit) != 0 {
+		t.Fatalf("non-inherited stacks=%+v", child)
+	}
+	if len(child.SkillStack) != 1 || child.SkillStack[0].SkillID != "before" {
+		t.Fatalf("skills=%+v", child.SkillStack)
+	}
+}
+
+func TestForkStateRejectsCorruptOrUnsupportedParent(t *testing.T) {
+	if _, _, err := ForkState([]byte("not-json"), ForkOptions{}); err == nil ||
+		!strings.Contains(err.Error(), "decode parent context") {
+		t.Fatalf("corrupt error=%v", err)
+	}
+	payload := []byte(`{"schema_version":99}`)
+	if _, _, err := ForkState(payload, ForkOptions{}); err == nil ||
+		!strings.Contains(err.Error(), "unsupported schema version 99") {
+		t.Fatalf("schema error=%v", err)
+	}
+}
