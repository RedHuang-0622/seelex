{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seelex.dev/schemas/session-snapshot.schema.json",
  "title": "Seelex session snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "scope", "session_id", "revision", "generation_id", "captured_at", "conversation", "history", "chat", "runtime"],
  "properties": {
    "protocol_version": { "$ref": "common.schema.json#/$defs/protocolVersion" },
    "scope": { "const": "session" },
    "session_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "revision": { "$ref": "common.schema.json#/$defs/revision" },
    "generation_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "captured_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "review_request": {
      "description": "Agent 发起的「请 GUI 在侧边资源管理器打开这些待审阅文件」批处理请求（会话作用域的可重放只读段：GUI 未开或被重连时，起来后按它补放；不是一次性事件）。缺省 = 该会话当前没有待审阅请求。清单只带路径与可选行区间/备注，文件内容仍走只读预览通道读回。",
      "anyOf": [
        { "$ref": "#/$defs/reviewRequest" },
        { "type": "null" }
      ]
    },
    "conversation": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/message" }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["has_more"],
      "properties": {
        "has_more": { "type": "boolean" },
        "next_cursor": { "type": "string", "minLength": 16, "maxLength": 2048 }
      }
    },
    "chat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lifecycle", "queued_count"],
      "properties": {
        "lifecycle": { "enum": ["idle", "queued", "running", "awaiting_approval", "error"] },
        "request_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "queued_count": { "type": "integer", "minimum": 0 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "provider", "plugin", "effort"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "plugin": { "type": "string" },
        "effort": { "enum": ["lite", "medium", "high", "max"] },
        "workspace_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "active_skills": {
          "description": "任务级激活 skill ID 列表（右侧栏「目标」面板数据源）。",
          "type": "array",
          "items": { "type": "string" }
        },
        "goal_skill_active": {
          "description": "GOAL 方法论 skill 激活投影（右侧栏「目标」面板 badge）。",
          "type": "boolean"
        },
        "plan": {
          "description": "Active WorkPlan execution state. Present only when a plan is loaded or running.",
          "anyOf": [
            { "$ref": "plan.schema.json" },
            { "type": "null" }
          ]
        }
      }
    }
  },
  "$defs": {
    "reviewRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "files"],
      "properties": {
        "request_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": { "$ref": "#/$defs/reviewFileRef" }
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "reason"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "reason": { "enum": ["sandbox", "sensitive", "binary", "missing", "duplicate"] }
            }
          }
        },
        "requested_at": { "$ref": "common.schema.json#/$defs/timestamp" }
      }
    },
    "reviewFileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "note": { "type": "string" },
        "start_line": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 }
      }
    },

    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message_id", "role", "content", "created_at"],
      "properties": {
        "message_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "role": { "enum": ["system", "user", "assistant", "tool", "tool_result", "error"] },
        "kind": {
          "description": "轨迹多线谱的显式类别（历史记录由后端按事件标注；空串表示旧数据，前端回退 role 判定）",
          "enum": ["user_input", "internal", "llm", "tool_call", "tool_output", "system", "error", "notice"]
        },
        "content": { "type": "string", "maxLength": 200000 },
        "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "card_id": { "$ref": "common.schema.json#/$defs/identifier" }
      }
    }
  }
}
