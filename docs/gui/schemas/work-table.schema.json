{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seelex.dev/schemas/work-table.schema.json",
  "title": "Work table event payload",
  "description": "worktable.changed 增量的 payload：工作台统一工作表格（plan 节点 / todolist 项 / task 主动任务 / fork 子代理 → WorkItem 行，含任务打点 trace）与批次分片头。只含表格与批次，不整份 runtime。",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/workItem" }
    },
    "batches": {
      "type": "array",
      "items": { "$ref": "#/$defs/workTableBatch" },
      "description": "批次分片头（可选增量）：一批 = 一次 chat 请求创建的全部条目；按 CreatedAt 升序，早期/未分批会话置底。"
    }
  },
  "$defs": {
    "workItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "phase", "task", "status", "kind"],
      "properties": {
        "id": { "type": "string", "pattern": "^(plan|todo|subagent|task):" },
        "phase": { "enum": ["plan", "tasklist", "task", "subagent"] },
        "task": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "assignee": { "type": "string", "description": "role:sessionID 被动识别身份（main:<mainSessionID> | subagent:<subagentSessionID>）" },
        "participants": { "type": "array", "items": { "type": "string" }, "description": "名单：创建者自动上名单，接管者（role:sessionID）追加并成为当前 Assignee" },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "attachments": { "type": "array", "items": { "type": "string" } },
        "kind": { "enum": ["plan", "todo", "task", "subagent"], "description": "权威类型：前端筛选/状态机按此判定" },
        "source_id": { "type": "string" },
        "batch_id": { "type": "string", "description": "所属批次（chat 请求 requestID；空串 = 早期/未分批会话）" },
        "batch_label": { "type": "string", "description": "批次展示标签（由最早 CreatedAt 派生；与 batches[].label 一致）" },
        "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "started_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "ended_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "elapsed": { "type": "string" },
        "trace": {
          "type": "array",
          "items": { "$ref": "#/$defs/tracePoint" }
        }
      }
    },
    "tracePoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "status": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "operation": { "type": "string" },
        "evidence": { "type": "string" },
        "duration": { "type": "string" }
      }
    },
    "workTableBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "counts"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["all", "plan", "task", "todo", "subagent"],
          "properties": {
            "all": { "type": "integer", "minimum": 0 },
            "plan": { "type": "integer", "minimum": 0 },
            "task": { "type": "integer", "minimum": 0 },
            "todo": { "type": "integer", "minimum": 0 },
            "subagent": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
